  "info": {
    "_postman_id": "61b51f76-9491-4135-80bf-08a8fc3e2d20",
    "name": "Lakera Guard Results API",
    "description": "Lakera Guard is an AI-native security platform that screens LLM application\ninputs and outputs for prompt attacks, data leakage, content violations, PII\nexposure, and malicious links. The Guard API exposes a single screening\nendpoint that accepts OpenAI-style chat messages and returns a flagged\nresponse, plus a results endpoint that returns detector confidence levels\nwithout making a runtime decision.\n\n\nContact Support:\n Name: Lakera\n Email: support@lakera.ai",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:01:44.000Z",
    "updatedAt": "2026-07-28T02:01:45.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-61b51f76-9491-4135-80bf-08a8fc3e2d20"
  },
