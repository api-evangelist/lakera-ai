                  "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"<string>\"\n    },\n    {\n      \"role\": \"tool\",\n      \"content\": \"<string>\"\n    }\n  ],\n  \"project_id\": \"<string>\"\n}",
