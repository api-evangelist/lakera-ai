          "name": "Get Detector Confidence Results",
          "request": {
            "name": "Get Detector Confidence Results",
            "description": {
              "content": "Returns detector confidence levels (L1 Confident through L5 Unlikely) for\nthe supplied content without making a runtime flagging decision and\nwithout contributing to logged screening activity. Intended for offline\nanalysis, threshold tuning, and quality monitoring rather than runtime\nenforcement.\n",
              "type": "text/plain"
            },
            "url": {
